{
  "name": "@webship-js/discourse-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for a Discourse forum, a plugin for webship-js (Playwright and Cucumber): the session; the topic lists (Latest, New, Unread, Top, Categories); a topic, read, replied to, quoted, liked, bookmarked and flagged; the composer with its preview and its draft; mentions and the notifications menu; personal messages; the quick and the full-page search with its filters; the profile and the preferences; the category and tag pages; the moderator's actions (close, pin, unlist); the admin dashboard, the site settings and the review queue.",
  "main": "tests/step-definitions/discourse-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "discourse",
    "forum",
    "community",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/discourse-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/discourse-steps/issues"
  },
  "homepage": "https://github.com/webship/discourse-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
